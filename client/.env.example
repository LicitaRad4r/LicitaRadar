# Valores ativos: computador local (Compose). Não coloque segredo neste arquivo.
VITE_API_URL=http://localhost:3333
# false: API real (padrão). true: mock em client/src/mocks.
VITE_API_MOCK=false
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-licitaradar
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
VITE_FIRESTORE_EMULATOR_HOST=localhost:8080

# Produção: o GitHub Actions é quem injeta estes valores no build. Não descomente no Compose.
# VITE_API_URL=https://<serviço>.onrender.com
# VITE_API_MOCK=false
# VITE_FIREBASE_API_KEY=        # variable VITE_FIREBASE_API_KEY, sem aspas
# VITE_FIREBASE_AUTH_DOMAIN=licitaradar-13047.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=licitaradar-13047
# Sem VITE_FIREBASE_AUTH_EMULATOR_URL e sem VITE_FIRESTORE_EMULATOR_HOST.
