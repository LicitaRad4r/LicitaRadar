rules_version = '2';

// Deny-all: nenhum cliente (SDK no browser) lê ou escreve no Firestore.
// Todo acesso a dados passa pela API, que usa o Admin SDK e ignora estas rules.
// Ver docs/arquitetura/decisoes_adrs/0001-firestore-deny-all.md e CT-SEG-010.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
