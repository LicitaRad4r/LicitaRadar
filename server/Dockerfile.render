# Imagem de produção da API (Render). O server/Dockerfile continua sendo o do docker compose (modo dev).
# Node 22, a mesma versão dos jobs do server no CI. O processo não roda como root.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
 && mkdir -p /app/.arquivos \
 && chown -R node:node /app
COPY --from=build --chown=node:node /app/dist ./dist
USER node
# O Render define PORT; o server.ts já lê process.env.PORT e escuta em 0.0.0.0.
CMD ["npm", "start"]
