# Copie para .env (cp .env.example .env). O .env NUNCA deve ser commitado.
# Todos os valores abaixo já têm padrão no docker-compose.yml; o .env é opcional em dev.

# Projeto Firebase. O prefixo "demo-" faz os emuladores rodarem sem projeto real no GCP.
FIREBASE_PROJECT_ID=demo-licitaradar

# Portas expostas na sua máquina
API_PORT=3333
WEB_PORT=5173

# Endereços usados pelo navegador (frontend)
VITE_API_URL=http://localhost:3333
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
VITE_FIRESTORE_EMULATOR_HOST=localhost:8080
