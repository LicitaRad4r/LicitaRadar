
# Projeto Firebase. O prefixo "demo-" faz os emuladores rodarem sem projeto real no GCP.
FIREBASE_PROJECT_ID=demo-licitaradar

# Portas expostas na sua máquina
API_PORT=3333
WEB_PORT=5173

# Endereços usados pelo navegador (frontend)
VITE_API_URL=http://localhost:3333
# false: o front usa a API real (padrão). Rode o seed antes de entrar (ver README).
# true: o front usa o mock da API (client/src/mocks), sem seed.
VITE_API_MOCK=false
# Chave só para o SDK no emulador (não é segredo de produção)
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
VITE_FIRESTORE_EMULATOR_HOST=localhost:8080

# Origens extras do CORS. O Compose usa o Vite local.
# Em produção o código também aceita https://licitaradar-13047.web.app,
# https://licitaradar-13047.firebaseapp.com e https://licitaradar-13047--*.web.app.
CORS_ORIGENS=http://localhost:5173

# pncp: API real do PNCP. fixtures: demonstração, só no emulador.
INGEST_FONTE=pncp

# Segredo do job de ingestão. Vazio no computador: a rota recusa tudo.
# O valor real fica no Render e no secret INGEST_JOB_TOKEN do GitHub, nunca aqui.
INGEST_JOB_TOKEN=
